{
  "profile": "pinet-pirc-x402-conformance",
  "profile_version": "0.1.0",
  "protocol": {
    "x402_version": 2,
    "scheme": "exact",
    "networks": ["pinet:testnet", "pinet:mainnet"]
  },
  "status": "scenario_catalogue_not_executed",
  "vectors": [
    {
      "id": "AMT-001",
      "category": "amount",
      "input": { "amount": "10000000" },
      "expected": "accept_if_within_verified_asset_range",
      "reason": "Canonical positive base-10 integer atomic amount."
    },
    {
      "id": "AMT-002",
      "category": "amount",
      "input": { "amount": "0" },
      "expected": "reject",
      "reason": "Payment amount must be positive."
    },
    {
      "id": "AMT-003",
      "category": "amount",
      "input": { "amount": "-1" },
      "expected": "reject",
      "reason": "Signed amount syntax is not accepted."
    },
    {
      "id": "AMT-004",
      "category": "amount",
      "input": { "amount": "1.25" },
      "expected": "reject",
      "reason": "Decimal notation is not an atomic-unit integer."
    },
    {
      "id": "AMT-005",
      "category": "amount",
      "input": { "amount": "1e6" },
      "expected": "reject",
      "reason": "Exponent notation is not accepted."
    },
    {
      "id": "AMT-006",
      "category": "amount",
      "input": { "amount": " 100 " },
      "expected": "reject",
      "reason": "Whitespace must not be silently normalized."
    },
    {
      "id": "NET-001",
      "category": "network",
      "input": {
        "network": "pinet:testnet",
        "expected_passphrase": "Pi Testnet",
        "observed_passphrase": "Pi Testnet"
      },
      "expected": "accept_network_identity",
      "reason": "Network identifier and exact passphrase agree."
    },
    {
      "id": "NET-002",
      "category": "network",
      "input": {
        "network": "pinet:testnet",
        "expected_passphrase": "Pi Testnet",
        "observed_passphrase": "Pi Network"
      },
      "expected": "reject_fail_closed",
      "reason": "Mainnet passphrase must not be accepted for Testnet."
    },
    {
      "id": "NET-003",
      "category": "network",
      "input": {
        "network": "pinet:unknown",
        "expected_passphrase": null,
        "observed_passphrase": null
      },
      "expected": "reject",
      "reason": "Unknown network identifiers are not inferred."
    },
    {
      "id": "XDR-001",
      "category": "transaction_structure",
      "input": {
        "operation_count": 2,
        "operation_types": ["invokeHostFunction", "payment"]
      },
      "expected": "reject",
      "reason": "Unexpected additional operation."
    },
    {
      "id": "XDR-002",
      "category": "transaction_structure",
      "input": {
        "operation_count": 1,
        "operation_types": ["invokeHostFunction"],
        "function_name": "transfer",
        "argument_count": 4
      },
      "expected": "reject",
      "reason": "Transfer invocation argument count does not match the scheme."
    },
    {
      "id": "SET-001",
      "category": "settlement",
      "input": {
        "idempotency_key": "intent-001",
        "payload_digest": "synthetic-payload-A",
        "prior_state": "settled"
      },
      "expected": "return_or_reconcile_existing_outcome",
      "reason": "A repeated identical request must not cause a second transfer."
    },
    {
      "id": "SET-002",
      "category": "settlement",
      "input": {
        "idempotency_key": "intent-001",
        "payload_digest": "synthetic-payload-B",
        "prior_state": "settled"
      },
      "expected": "reject_conflicting_reuse",
      "reason": "An idempotency identity cannot be rebound to a different payment payload."
    },
    {
      "id": "SET-003",
      "category": "settlement_recovery",
      "input": {
        "broadcast_result": "accepted",
        "confirmation_result": "timeout",
        "persisted_transaction_identity": true
      },
      "expected": "pending_reconcile_before_retry",
      "reason": "An uncertain broadcast outcome must be reconciled before any retry."
    },
    {
      "id": "PIRC-001",
      "category": "provenance",
      "input": {
        "asset_verification_state": "disputed",
        "allowlisted_contract": false
      },
      "expected": "reject_asset",
      "reason": "Unverified provenance does not authorize an asset for payment."
    },
    {
      "id": "PIRC-002",
      "category": "oracle",
      "input": {
        "source_count": 2,
        "minimum_sources": 3,
        "fresh": true
      },
      "expected": "quarantine_or_reject_quote",
      "reason": "Below-quorum oracle data cannot be promoted to a trusted price input."
    },
    {
      "id": "PIRC-003",
      "category": "commerce",
      "input": {
        "payment_state": "verified",
        "settlement_state": "pending",
        "fulfillment_requested": true
      },
      "expected": "block_fulfillment",
      "reason": "Verification alone is not settlement finality."
    },
    {
      "id": "PIRC-004",
      "category": "accounting",
      "input": {
        "collected_atomic": "1000",
        "deductions_atomic": "250",
        "allocations_atomic": "800"
      },
      "expected": "reject_non_conserving_allocation",
      "reason": "Allocations exceed the distributable amount."
    }
  ],
  "limitations": [
    "These are declarative scenarios, not signed XDR transaction fixtures.",
    "No network request, signature verification, contract read-back, or payment was performed by publishing this file.",
    "Implementations must derive asset decimals, contract allowlists, protocol rules, and finality behavior from verified network-specific sources."
  ]
}
